{
  "expo": {
    "name": "BLE Offline Chat",
    "slug": "ble-offline-chat",
    "version": "1.0.0",
    "platforms": ["android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.bleofflinechat.prototype",
      "permissions": ["android.permission.BLUETOOTH_ADVERTISE"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      ["react-native-ble-plx", { "neverForLocation": true }],
      "./plugins/withLegacyBluetoothPermissionLimits"
    ]
  }
}
